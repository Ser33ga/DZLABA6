        </mxCell>
        <mxCell id="calc" value="y1 = x + 4&lt;br&gt;y2 = -x + 4&lt;br&gt;y3 = 0" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.5;fillColor=#ffffff;fontFamily=Arial;fontSize=14;fontColor=#000000;" vertex="1" parent="1">
